  {placement !== 'top' && <>
    <script is:inline>
      atOptions = { key: '55aab83d0c43ce72c6d1017c87204042', format: 'iframe', height: 300, width: 160, params: {} };
    </script>
    <script is:inline src="https://overestimatecapricornspittle.com/55aab83d0c43ce72c6d1017c87204042/invoke.js"></script>

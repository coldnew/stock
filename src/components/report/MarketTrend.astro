---
import CandlestickChart from './CandlestickChart';
import NavTrendChart from './NavTrendChart';
import { marketSnapshots } from '../../data/market';
import { navSnapshots } from '../../data/nav';

interface Props { ticker: string; locale?: 'zh-TW'; }
const { ticker, locale } = Astro.props as Props;
const snapshot = marketSnapshots[ticker.toUpperCase()];
const navSnapshot = navSnapshots[ticker.toUpperCase()];
const rows = snapshot?.rows ?? [];
const dataUrl = `/stock/data/market/${ticker.toUpperCase()}.json`;
const firstClose = rows[0]?.[4] ?? 0;
const lastClose = rows.at(-1)?.[4] ?? 0;
const change = firstClose ? ((lastClose / firstClose) - 1) * 100 : 0;
const high = rows.length ? Math.max(...rows.map((row) => row[2])) : 0;
const low = rows.length ? Math.min(...rows.map((row) => row[3])) : 0;
---
{snapshot && rows.length > 1 ? <>
  <CandlestickChart client:load locale={locale} dataUrl={dataUrl} />
  <div class="chart-summary" aria-label="圖表摘要">
    <span>30 交易日報酬 <strong class={change >= 0 ? 'positive' : 'negative'}>{change >= 0 ? '+' : ''}{change.toFixed(2)}%</strong></span>
    <span>區間 <strong>{low.toFixed(2)}–{high.toFixed(2)}</strong></span>
    <span>最新收盤 <strong>{lastClose.toFixed(2)}</strong></span>
  </div>
  <p class="chart-source">資料來源：Yahoo Finance OHLC 行情資料；{rows.length} 個完成交易日，截止 {rows.at(-1)?.[0]}。</p>
  {navSnapshot && <NavTrendChart client:load ticker={ticker.toUpperCase()} dataUrl={`/stock/data/nav/${ticker.toUpperCase()}.json`} source={navSnapshot.source} dataAsOf={navSnapshot.dataAsOf} />}
</> : <p class="chart-source">此報告類型目前沒有可用的市場圖表。</p>}

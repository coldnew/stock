---
import type { CollectionEntry } from 'astro:content';
import AdSlot from './AdSlot.astro';
import MonetizationScripts from './MonetizationScripts.astro';
import Analytics from './Analytics.astro';
import AiDisclosure from './AiDisclosure.astro';
import { latestByTicker } from '../../data/reports';
import { individualWatchlist, etfWatchlist, watchlist } from '../../data/watchlist';
import { groupReportsByTag, tagHref } from '../../data/tags';
import SearchDialog from './SearchDialog.astro';
import '../../styles/index.css';

const { reports, allReports = reports, page = 1, pageSize = 10 } = Astro.props as { reports: CollectionEntry<'reports'>[]; allReports?: CollectionEntry<'reports'>[]; page?: number; pageSize?: number };
const latest = latestByTicker(allReports);
const dateLabel = (date: Date) => date.toISOString().slice(0, 10);
const reportUrl = (report: CollectionEntry<'reports'>) => {
  const base = `/stock/reports/${report.data.ticker.toLowerCase()}`;
  return latest.get(`${report.data.locale}:${report.data.ticker}`)?.id === report.id ? `${base}/` : `${base}/${dateLabel(report.data.publishedAt)}/`;
};
const deskLabel = (report: CollectionEntry<'reports'>) => report.data.tags.includes('Q2 2026') ? '季度財報' : report.data.tags.includes('income-etf') ? '收益策略' : report.data.tags.includes('equity') ? '個股研究' : report.data.tags.includes('crypto') ? '數位資產' : '市場研究';
const totalPages = Math.max(1, Math.ceil(allReports.length / pageSize));
const currentPage = Math.min(Math.max(page, 1), totalPages);
const feed = allReports.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const priorityTickers = ['TSLA', 'GOOG', 'AAPL', 'MSFT', 'NVDA', 'AMD'];
const coverage = [...reports].sort((a, b) => {
  const priority = (ticker: string) => {
    const featured = priorityTickers.indexOf(ticker);
    if (featured !== -1) return featured;
    const tracked = watchlist.indexOf(ticker);
    return priorityTickers.length + (tracked === -1 ? watchlist.length : tracked);
  };
  return priority(a.data.ticker) - priority(b.data.ticker) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
});
const equityCoverage = coverage.filter((report) => individualWatchlist.includes(report.data.ticker));
const etfCoverage = coverage.filter((report) => etfWatchlist.includes(report.data.ticker));
const tagCloud = groupReportsByTag(allReports).slice(0, 18);
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>每日投資研究</title><meta name="description" content="每日更新的公司、ETF 與市場事件實證研究。" /><link rel="alternate" type="application/rss+xml" title="每日投資研究 RSS" href="/stock/rss.xml" />
    <link rel="canonical" href={`https://coldnew.github.io/stock${currentPage === 1 ? '/' : `/page/${currentPage}/`}`} /><Analytics />
  </head>
  <body>
    <header class="index-header">
      <nav class="site-nav"><a class="site-mark" href="/stock/">RESEARCH DESK</a><span>每日投資筆記</span><SearchDialog /></nav>
      <p class="eyebrow">每日投資研究</p><h1>用更冷靜的方式閱讀市場。</h1>
      <p class="index-intro">每天只回答三件事：發生了什麼、什麼真正重要，以及什麼情況會讓投資論點改變。</p>
      <p class="index-note">本站報告以台灣投資人為主要對象。收益型基金的配息可能包含 ROC（資本返還）；稅務與投資決策請以第一手資料及專業意見為準。</p>
      <AiDisclosure locale="zh-TW" />
    </header>
    <AdSlot placement="top" />
    <main>
      <section class="coverage" aria-labelledby="coverage-title"><div class="section-heading"><p class="eyebrow">明確列入追蹤的標的</p><h2 id="coverage-title">目前追蹤</h2><p class="coverage-note">只有列入個股或 ETF 追蹤清單的標的會顯示在這裡；其他研究文章仍會出現在下方每日報導，但不代表本站持續追蹤。</p></div><div class="coverage-tabs" data-tab-group="coverage" role="tablist" aria-label="追蹤清單分類"><button type="button" role="tab" aria-selected="true" aria-controls="coverage-equity" id="coverage-tab-equity" data-tab-target="coverage-equity">個股追蹤 <span>{equityCoverage.length}</span></button><button type="button" role="tab" aria-selected="false" aria-controls="coverage-etf" id="coverage-tab-etf" data-tab-target="coverage-etf">ETF 追蹤 <span>{etfCoverage.length}</span></button></div><div class="coverage-panel" role="tabpanel" id="coverage-equity" aria-labelledby="coverage-tab-equity" data-tab-panel="coverage-equity"><div class="coverage-grid">{equityCoverage.map((report) => <a class="coverage-item" href={reportUrl(report)}><span class="ticker">{report.data.ticker}</span><span>{report.data.title}</span><span aria-hidden="true">↗</span></a>)}</div></div><div class="coverage-panel" role="tabpanel" id="coverage-etf" aria-labelledby="coverage-tab-etf" data-tab-panel="coverage-etf" hidden><div class="coverage-grid">{etfCoverage.map((report) => <a class="coverage-item" href={reportUrl(report)}><span class="ticker">{report.data.ticker}</span><span>{report.data.title}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>
      <section class="tag-cloud-section" aria-labelledby="tag-cloud-title"><div class="section-heading"><p class="eyebrow">文章索引</p><h2 id="tag-cloud-title">依標籤瀏覽</h2></div><div class="tag-cloud">{tagCloud.map((tag) => <a class="tag-link" href={tagHref(tag.label)}>#{tag.label}<span>{tag.reports.length}</span></a>)}</div></section>
      <section class="daily-feed" aria-labelledby="feed-title"><div class="section-heading"><p class="eyebrow">編輯室文章</p><h2 id="feed-title">每日報導</h2></div><div class="post-list">{feed.map((report) => <article class="post-row"><div class="post-row-meta"><strong>{report.data.ticker}</strong><time datetime={dateLabel(report.data.publishedAt)}>{dateLabel(report.data.publishedAt)}</time><span>{deskLabel(report)}</span></div><div><h3><a href={reportUrl(report)}>{report.data.title}</a></h3><p>{report.data.description}</p><a class="read-link" href={reportUrl(report)}>繼續閱讀 →</a></div></article>)}</div><nav class="pagination" aria-label="每日報導分頁">{currentPage > 1 && <a class="pagination-prev" href={currentPage === 2 ? '/stock/' : `/stock/page/${currentPage - 1}/`} rel="prev">‹ 上一頁</a>}<div class="pagination-pages">{Array.from({ length: totalPages }, (_, index) => index + 1).map((number) => number === currentPage ? <span aria-current="page">{number}</span> : <a href={number === 1 ? '/stock/' : `/stock/page/${number}/`}>{number}</a>)}</div>{currentPage < totalPages && <a class="pagination-next" href={`/stock/page/${currentPage + 1}/`} rel="next">下一頁 ›</a>}</nav></section>
      <AdSlot placement="mid" />
    </main>
    <AdSlot placement="bottom" /><AdSlot placement="smartlink" />
    <footer class="index-footer"><span>僅供教育與資訊參考，不構成投資建議。</span><span class="footer-links"><a href="/stock/about.html">關於本站</a><a href="/stock/privacy.html">隱私權政策</a><a href="/stock/disclaimer.html">免責聲明</a></span></footer>
    <script is:inline src="/stock/report-interactions.js"></script>
    <script is:inline>
      (function () {
        var group = document.querySelector('[data-tab-group="coverage"]');
        if (!group) return;
        var tabs = Array.prototype.slice.call(group.querySelectorAll('[role="tab"]'));
        function activate(tab) {
          tabs.forEach(function (item) {
            var selected = item === tab;
            item.setAttribute('aria-selected', String(selected));
            item.tabIndex = selected ? 0 : -1;
            var panel = document.getElementById(item.getAttribute('aria-controls'));
            if (panel) panel.hidden = !selected;
          });
        }
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () { activate(tab); });
          tab.addEventListener('keydown', function (event) {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            var index = tabs.indexOf(tab);
            var next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
            tabs[next].focus();
            activate(tabs[next]);
          });
        });
      })();
    </script>
    <MonetizationScripts />
  </body>
</html>

---
import type { CollectionEntry } from 'astro:content';
import AdSlot from './AdSlot.astro';
import MonetizationScripts from './MonetizationScripts.astro';
import Analytics from './Analytics.astro';
import AiDisclosure from './AiDisclosure.astro';
import '../../styles/index.css';

const { reports, allReports = reports, locale } = Astro.props as {
  reports: CollectionEntry<'reports'>[];
  allReports?: CollectionEntry<'reports'>[];
  locale: 'zh-TW' | 'en';
};
const isEnglish = locale === 'en';
const dateLabel = (date: Date) => date.toISOString().slice(0, 10);
const reportUrl = (report: CollectionEntry<'reports'>) => {
  const base = `/stock/${isEnglish ? 'en/' : ''}reports/${report.data.ticker.toLowerCase()}`;
  return report.data.isLatest ? `${base}/` : `${base}/${dateLabel(report.data.publishedAt)}/`;
};
const deskLabel = (report: CollectionEntry<'reports'>) => {
  if (report.data.tags.includes('Q2 2026')) return isEnglish ? 'Quarterly review' : '季度財報';
  if (report.data.tags.includes('income-etf')) return isEnglish ? 'Income strategy' : '收益策略';
  if (report.data.tags.includes('equity')) return isEnglish ? 'Company research' : '個股研究';
  if (report.data.tags.includes('crypto')) return isEnglish ? 'Digital assets' : '數位資產';
  return isEnglish ? 'Market research' : '市場研究';
};
const lead = allReports[0];
const feed = allReports.slice(1, 11);
const coverage = reports.slice(0, 12);
const editionsByTicker = new Map<string, CollectionEntry<'reports'>[]>();
allReports.forEach((report) => {
  const editions = editionsByTicker.get(report.data.ticker) ?? [];
  editions.push(report);
  editionsByTicker.set(report.data.ticker, editions);
});
const archivedTickers = [...editionsByTicker.entries()].filter(([, editions]) => editions.length > 1).sort(([a], [b]) => a.localeCompare(b));
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{isEnglish ? 'Daily Investment Research' : '每日投資研究'}</title>
    <meta name="description" content={isEnglish ? 'Daily, evidence-based investment research on companies, ETFs, and market events.' : '每日更新的公司、ETF 與市場事件實證研究。'} />
    <link rel="canonical" href={`https://coldnew.github.io/stock/${isEnglish ? 'en/' : ''}`} />
    <Analytics />
  </head>
  <body>
    <header class="index-header">
      <nav class="site-nav"><a class="site-mark" href={`/stock/${isEnglish ? 'en/' : ''}`}>RESEARCH DESK</a><span>{isEnglish ? 'Daily investment notes' : '每日投資筆記'}</span></nav>
      <p class="eyebrow">{isEnglish ? 'Daily investment research' : '每日投資研究'}</p>
      <h1>{isEnglish ? 'A calmer way to read the market.' : '用更冷靜的方式閱讀市場。'}</h1>
      <p class="index-intro">{isEnglish ? 'A daily post on what changed, what matters, and what would make the thesis change.' : '每天只回答三件事：發生了什麼、什麼真正重要，以及什麼情況會讓投資論點改變。'}</p>
      {!isEnglish && <p class="index-note">本站報告以台灣投資人為主要對象。收益型基金的配息可能包含 ROC（資本返還）；稅務與投資決策請以第一手資料及專業意見為準。</p>}
      <AiDisclosure locale={locale} />
    </header>
    <AdSlot placement="top" />
    <main>
      {lead && <article class="lead-post">
        <div class="post-kicker"><span>{isEnglish ? 'Latest edition' : '最新一篇'}</span><span>{dateLabel(lead.data.publishedAt)}</span></div>
        <div class="post-meta"><span class="ticker">{lead.data.ticker}</span><span>{deskLabel(lead)}</span></div>
        <h2><a href={reportUrl(lead)}>{lead.data.title}</a></h2>
        <p>{lead.data.description}</p>
        <a class="read-link" href={reportUrl(lead)}>{isEnglish ? 'Read the full post' : '閱讀完整文章'} <span aria-hidden="true">→</span></a>
      </article>}

      <section class="daily-feed" aria-labelledby="feed-title">
        <div class="section-heading"><p class="eyebrow">{isEnglish ? 'From the desk' : '編輯室文章'}</p><h2 id="feed-title">{isEnglish ? 'The daily feed' : '每日報導'}</h2></div>
        <div class="post-list">
          {feed.map((report) => <article class="post-row">
            <div class="post-row-meta"><strong>{report.data.ticker}</strong><time datetime={dateLabel(report.data.publishedAt)}>{dateLabel(report.data.publishedAt)}</time><span>{deskLabel(report)}</span></div>
            <div><h3><a href={reportUrl(report)}>{report.data.title}</a></h3><p>{report.data.description}</p><a class="read-link" href={reportUrl(report)}>{isEnglish ? 'Continue reading' : '繼續閱讀'} →</a></div>
          </article>)}
        </div>
      </section>
      <AdSlot placement="mid" />

      <section class="coverage" aria-labelledby="coverage-title">
        <div class="section-heading"><p class="eyebrow">{isEnglish ? 'Follow the names' : '追蹤清單'}</p><h2 id="coverage-title">{isEnglish ? 'Current coverage' : '目前追蹤'}</h2></div>
        <div class="coverage-grid">{coverage.map((report) => <a class="coverage-item" href={reportUrl(report)}><span class="ticker">{report.data.ticker}</span><span>{report.data.title}</span><span aria-hidden="true">↗</span></a>)}</div>
      </section>
    </main>
    <section class="archive-guide" aria-labelledby="archive-title">
      <h2 id="archive-title">{isEnglish ? 'Browse the archive' : '回看歷史文章'}</h2>
      <p>{isEnglish ? 'Dated editions stay available so you can compare how facts, risks, and conclusions changed.' : '保留日期版本，方便比較事實、風險與結論如何隨時間變化。'}</p>
      {archivedTickers.length > 0 && <div class="archive-list">{archivedTickers.map(([ticker, editions]) => <details>
        <summary><span>{ticker} · {editions[0].data.title}</span><span class="archive-count">{editions.length} {isEnglish ? 'editions' : '個版本'}</span></summary>
        <ul>{[...editions].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).map((edition) => <li><a href={reportUrl(edition)}>{dateLabel(edition.data.publishedAt)} · {edition.data.title}</a></li>)}</ul>
      </details>)}</div>}
    </section>
    <AdSlot placement="bottom" />
    <AdSlot placement="smartlink" />
    <footer class="index-footer"><span>{isEnglish ? 'For educational purposes only. Not financial advice.' : '僅供教育與資訊參考，不構成投資建議。'}</span><span class="footer-links"><a href="/stock/about.html">{isEnglish ? 'About' : '關於本站'}</a><a href="/stock/privacy.html">{isEnglish ? 'Privacy' : '隱私權政策'}</a><a href="/stock/disclaimer.html">{isEnglish ? 'Disclaimer' : '免責聲明'}</a></span></footer>
    <script is:inline src="/stock/report-interactions.js"></script>
    <MonetizationScripts />
  </body>
</html>

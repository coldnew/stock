---
import type { CollectionEntry } from 'astro:content';
import AdSlot from './AdSlot.astro';
import MonetizationScripts from './MonetizationScripts.astro';
import Analytics from './Analytics.astro';
import AiDisclosure from './AiDisclosure.astro';
import '../../styles/index.css';

const { reports, allReports = reports, locale } = Astro.props as {
  reports: CollectionEntry<'reports'>[];
  allReports?: CollectionEntry<'reports'>[];
  locale: 'zh-TW' | 'en';
};
const isEnglish = locale === 'en';
const editionsByTicker = new Map<string, CollectionEntry<'reports'>[]>();
allReports.forEach((report) => {
  const editions = editionsByTicker.get(report.data.ticker) ?? [];
  editions.push(report);
  editionsByTicker.set(report.data.ticker, editions);
});
const archivedTickers = [...editionsByTicker.entries()]
  .filter(([, editions]) => editions.length > 1)
  .sort(([a], [b]) => a.localeCompare(b));
const dateLabel = (date: Date) => date.toISOString().slice(0, 10);
const groups = isEnglish
  ? [
      { tickers: ['OVL', 'QQQI', 'BTCI', 'GPIQ', 'SPYI', 'JEPI', 'JEPQ', 'QDVO'], title: 'Income ETFs', subtitle: 'Option income, distribution composition, and downside behavior.', tag: 'Income strategy analysis' },
      { tickers: ['DGRO', 'IQQ', 'SGOV', 'QQQH', 'CHPY'], title: 'Core allocations and cash tools', subtitle: 'Dividend growth, passive benchmarks, hedged income, and Treasury-bill exposure.', tag: 'Portfolio construction analysis' },
      { tickers: ['MAGS'], title: 'Thematic ETFs', subtitle: 'Concentrated exposure and the trade-off between convenience and volatility.', tag: 'Thematic ETF analysis' },
      { tickers: ['DRAM', 'TQQQ', 'QQQ'], title: 'Industry themes and benchmarks', subtitle: 'Semiconductor industry exposure, leveraged products, and the Nasdaq-100 benchmark.', tag: 'Market structure analysis' },
      { tickers: ['TSLA', 'ARCC', 'SPCX', 'NVDA', 'GOOG', 'AAPL', 'MSFT', 'AMD'], title: 'Individual equities', subtitle: 'Company-level research on valuation, earnings, and execution risk.', tag: 'Fundamental equity analysis' },
    ]
  : [
      { tickers: ['OVL', 'QQQI', 'BTCI', 'GPIQ', 'SPYI', 'JEPI', 'JEPQ', 'QDVO', 'GPIX', 'IWMI'], title: '收益型 ETF', subtitle: '備兌看漲、賣權價差與領口策略：配息組成、下檔捕獲率與 NAV 侵蝕的實證研究。', tag: '收益策略分析' },
      { tickers: ['DGRO', 'IQQ', 'SGOV', 'QQQH', 'CHPY'], title: '核心配置與現金工具', subtitle: '不賣選擇權的部位：股息成長核心、被動指數與國庫券現金錨。', tag: '核心配置分析' },
      { tickers: ['MAGS'], title: '主題 ETF', subtitle: '單一主題的集中曝險：一鍵打包的時間節省 vs 七檔全押的波動。', tag: '主題 ETF 分析' },
      { tickers: ['DRAM', 'TQQQ', 'QQQ'], title: '產業主題與市場基準', subtitle: '記憶體產業、槓桿產品與納斯達克100基準的結構與風險分析。', tag: '市場結構分析' },
      { tickers: ['TSLA', 'ARCC', 'SPCX', 'NVDA', 'GOOG', 'AAPL', 'MSFT', 'AMD'], title: '個股基本面', subtitle: '單一公司深度研究：估值、獲利結構與波動風險。', tag: '個股基本面分析' },
    ];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{isEnglish ? 'Stock Research Reports' : '股票分析報告'}</title>
    <meta name="description" content={isEnglish ? 'Evidence-based research on income ETFs, option strategies, and selected equities.' : '收益型 ETF、選擇權策略與個股的實證分析報告。'} />
    <link rel="canonical" href={`https://coldnew.github.io/stock/${isEnglish ? 'en/' : ''}`} />
    <Analytics />
  </head>
  <body>
    <header class="index-header">
      <p class="eyebrow">{isEnglish ? 'Investment Research' : '投資研究'}</p>
      <h1>{isEnglish ? 'Stock Research Reports' : '股票分析報告'}</h1>
      <p>{isEnglish ? 'Evidence-based research on income strategies, core allocations, and selected companies, written for an international audience.' : '收益策略、核心配置與個股的實證研究，涵蓋配息結構、下檔風險與市場資料。'}</p>
      {(!isEnglish) && <p class="index-note">本站報告以台灣投資人為主要對象。收益型基金的配息可能包含 ROC（Return of Capital，資本返還）；美國預扣稅與台灣申報規則仍須分開判斷，詳情請以各報告的第一手資料與專業意見為準。</p>}
      <AiDisclosure locale={locale} />
    </header>
    <AdSlot placement="top" />
    <main class="report-list">
      {groups.map((group) => {
        const groupReports = group.tickers.flatMap((ticker) => reports.filter((report) => report.data.ticker === ticker));
        if (!groupReports.length) return null;
        return <>
          <h2 class="group-title">{group.title}</h2>
          <p class="group-sub">{group.subtitle}</p>
          {groupReports.map((report) => <a class="report-card" href={`/stock/${isEnglish ? 'en/' : ''}reports/${report.data.ticker.toLowerCase()}/`}>
            <span class="tag">{group.tag}</span>
            <h2>{report.data.title}</h2>
            <p>{report.data.description}</p>
            <span class="read-more">{isEnglish ? 'Read full report' : '閱讀完整報告'} →</span>
          </a>)}
        </>;
      })}
    </main>
    <section class="archive-guide" aria-labelledby="archive-title">
      <h2 id="archive-title">{isEnglish ? 'Browse report history' : '回看歷史報告'}</h2>
      <p>{archivedTickers.length
        ? (isEnglish ? 'Compare dated editions to see how market data, risks, and conclusions changed over time.' : '依日期比較不同版本，了解市場資料、風險與分析結論如何隨時間變化。')
        : (isEnglish ? 'New dated editions will appear here when a report is updated. Each snapshot remains available for comparison.' : '報告更新後，新的日期版本會在這裡出現；每個快照都會保留，方便日後比較。')}</p>
      {archivedTickers.length > 0 && <div class="archive-list">
        {archivedTickers.map(([ticker, editions]) => {
          const latestEdition = editions.find((edition) => edition.data.isLatest) ?? editions[0];
          return <details>
            <summary><span>{ticker} · {latestEdition.data.title}</span><span class="archive-count">{editions.length} {isEnglish ? 'editions' : '個版本'}</span></summary>
            <ul>
              {[...editions].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).map((edition) => <li>
                <a href={`/stock/${isEnglish ? 'en/' : ''}reports/${ticker.toLowerCase()}/${dateLabel(edition.data.publishedAt)}/`}>{dateLabel(edition.data.publishedAt)} · {edition.data.title}</a>
              </li>)}
            </ul>
          </details>;
        })}
      </div>}
    </section>
    <AdSlot placement="bottom" />
    <AdSlot placement="smartlink" />
    <footer class="index-footer"><span>{isEnglish ? 'For educational purposes only. Not financial advice.' : '僅供教育與資訊參考，不構成投資建議。'}</span><span class="footer-links"><a href="/stock/about.html">{isEnglish ? 'About' : '關於本站'}</a><a href="/stock/privacy.html">{isEnglish ? 'Privacy' : '隱私權政策'}</a><a href="/stock/disclaimer.html">{isEnglish ? 'Disclaimer' : '免責聲明'}</a></span></footer>
    <script is:inline src="/stock/report-interactions.js"></script>
    <MonetizationScripts />
  </body>
</html>

---
import type { CollectionEntry } from 'astro:content';
import AdSlot from './AdSlot.astro';
import MonetizationScripts from './MonetizationScripts.astro';
import Analytics from './Analytics.astro';
import AiDisclosure from './AiDisclosure.astro';
import { latestByTicker } from '../../data/reports';
import { watchlist } from '../../data/watchlist';
import '../../styles/index.css';

const { reports, allReports = reports } = Astro.props as { reports: CollectionEntry<'reports'>[]; allReports?: CollectionEntry<'reports'>[] };
const latest = latestByTicker(allReports);
const dateLabel = (date: Date) => date.toISOString().slice(0, 10);
const reportUrl = (report: CollectionEntry<'reports'>) => {
  const base = `/stock/reports/${report.data.ticker.toLowerCase()}`;
  return latest.get(`${report.data.locale}:${report.data.ticker}`)?.id === report.id ? `${base}/` : `${base}/${dateLabel(report.data.publishedAt)}/`;
};
const deskLabel = (report: CollectionEntry<'reports'>) => report.data.tags.includes('Q2 2026') ? '季度財報' : report.data.tags.includes('income-etf') ? '收益策略' : report.data.tags.includes('equity') ? '個股研究' : report.data.tags.includes('crypto') ? '數位資產' : '市場研究';
const latestResearch = allReports.slice(0, 3);
const feed = allReports.slice(3, 13);
const priorityTickers = ['TSLA', 'GOOG', 'AAPL', 'MSFT', 'NVDA', 'AMD'];
const coverage = [...reports].sort((a, b) => {
  const priority = (ticker: string) => {
    const featured = priorityTickers.indexOf(ticker);
    if (featured !== -1) return featured;
    const tracked = watchlist.indexOf(ticker);
    return priorityTickers.length + (tracked === -1 ? watchlist.length : tracked);
  };
  return priority(a.data.ticker) - priority(b.data.ticker) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
});
const editionsByTicker = new Map<string, CollectionEntry<'reports'>[]>();
allReports.forEach((report) => { const editions = editionsByTicker.get(report.data.ticker) ?? []; editions.push(report); editionsByTicker.set(report.data.ticker, editions); });
const archivedTickers = [...editionsByTicker.entries()].filter(([, editions]) => editions.length > 1).sort(([a], [b]) => a.localeCompare(b));
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>每日投資研究</title><meta name="description" content="每日更新的公司、ETF 與市場事件實證研究。" /><link rel="alternate" type="application/rss+xml" title="每日投資研究 RSS" href="/stock/rss.xml" />
    <link rel="canonical" href="https://coldnew.github.io/stock/" /><Analytics />
  </head>
  <body>
    <header class="index-header">
      <nav class="site-nav"><a class="site-mark" href="/stock/">RESEARCH DESK</a><span>每日投資筆記</span></nav>
      <p class="eyebrow">每日投資研究</p><h1>用更冷靜的方式閱讀市場。</h1>
      <p class="index-intro">每天只回答三件事：發生了什麼、什麼真正重要，以及什麼情況會讓投資論點改變。</p>
      <p class="index-note">本站報告以台灣投資人為主要對象。收益型基金的配息可能包含 ROC（資本返還）；稅務與投資決策請以第一手資料及專業意見為準。</p>
      <AiDisclosure locale="zh-TW" />
    </header>
    <AdSlot placement="top" />
    <main>
      <section class="coverage" aria-labelledby="coverage-title"><div class="section-heading"><p class="eyebrow">追蹤清單</p><h2 id="coverage-title">目前追蹤</h2></div><div class="coverage-grid">{coverage.map((report) => <a class="coverage-item" href={reportUrl(report)}><span class="ticker">{report.data.ticker}</span><span>{report.data.title}</span><span aria-hidden="true">↗</span></a>)}</div></section>
      {latestResearch.length > 0 && <section class="latest-research" aria-labelledby="latest-title"><div class="section-heading"><p class="eyebrow">最新研究</p><h2 id="latest-title">今天值得先讀</h2></div><div class="latest-research-grid">{latestResearch.map((report, index) => <article class:list={["lead-post", index === 0 && "lead-post-featured"]}><div class="post-kicker"><span>{dateLabel(report.data.publishedAt)}</span></div><div class="post-meta"><span class="ticker">{report.data.ticker}</span><span>{deskLabel(report)}</span></div><h2><a href={reportUrl(report)}>{report.data.title}</a></h2><p>{report.data.description}</p><a class="read-link" href={reportUrl(report)}>閱讀完整文章 <span aria-hidden="true">→</span></a></article>)}</div></section>}
      <section class="daily-feed" aria-labelledby="feed-title"><div class="section-heading"><p class="eyebrow">編輯室文章</p><h2 id="feed-title">每日報導</h2></div><div class="post-list">{feed.map((report) => <article class="post-row"><div class="post-row-meta"><strong>{report.data.ticker}</strong><time datetime={dateLabel(report.data.publishedAt)}>{dateLabel(report.data.publishedAt)}</time><span>{deskLabel(report)}</span></div><div><h3><a href={reportUrl(report)}>{report.data.title}</a></h3><p>{report.data.description}</p><a class="read-link" href={reportUrl(report)}>繼續閱讀 →</a></div></article>)}</div></section>
      <AdSlot placement="mid" />
    </main>
    <section class="archive-guide" aria-labelledby="archive-title"><h2 id="archive-title">回看歷史文章</h2><p>保留日期版本，方便比較事實、風險與結論如何隨時間變化。</p>{archivedTickers.length > 0 && <div class="archive-list">{archivedTickers.map(([ticker, editions]) => <details><summary><span>{ticker} · {editions[0].data.title}</span><span class="archive-count">{editions.length} 個版本</span></summary><ul>{[...editions].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).map((edition) => <li><a href={reportUrl(edition)}>{dateLabel(edition.data.publishedAt)} · {edition.data.title}</a></li>)}</ul></details>)}</div>}</section>
    <AdSlot placement="bottom" /><AdSlot placement="smartlink" />
    <footer class="index-footer"><span>僅供教育與資訊參考，不構成投資建議。</span><span class="footer-links"><a href="/stock/about.html">關於本站</a><a href="/stock/privacy.html">隱私權政策</a><a href="/stock/disclaimer.html">免責聲明</a></span></footer>
    <script is:inline src="/stock/report-interactions.js"></script><MonetizationScripts />
  </body>
</html>

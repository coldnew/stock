---
import type { CollectionEntry } from 'astro:content';
import AdSlot from './AdSlot.astro';
import MonetizationScripts from './MonetizationScripts.astro';
import Analytics from './Analytics.astro';
import AiDisclosure from './AiDisclosure.astro';
import { latestByTicker } from '../../data/reports';
import { trackedAssets, trackedAssetByTicker, watchlist } from '../../data/watchlist';
import { groupReportsByTag, tagHref } from '../../data/tags';
import SearchDialog from './SearchDialog.astro';
import '../../styles/index.css';

const { reports, allReports = reports, page = 1, pageSize = 10 } = Astro.props as { reports: CollectionEntry<'reports'>[]; allReports?: CollectionEntry<'reports'>[]; page?: number; pageSize?: number };
const latest = latestByTicker(allReports);
const dateLabel = (date: Date) => date.toISOString().slice(0, 10);
const reportUrl = (report: CollectionEntry<'reports'>) => {
  const base = `/stock/reports/${report.data.ticker.toLowerCase()}`;
  return latest.get(`${report.data.locale}:${report.data.ticker}`)?.id === report.id ? `${base}/` : `${base}/${dateLabel(report.data.publishedAt)}/`;
};
const deskLabel = (report: CollectionEntry<'reports'>) => report.data.tags.includes('Q2 2026') ? '季度財報' : report.data.tags.includes('income-etf') ? '收益策略' : report.data.tags.includes('equity') ? '個股研究' : report.data.tags.includes('crypto') ? '數位資產' : '市場研究';
const totalPages = Math.max(1, Math.ceil(allReports.length / pageSize));
const currentPage = Math.min(Math.max(page, 1), totalPages);
const feed = allReports.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const priorityTickers = ['TSLA', 'GOOG', 'AAPL', 'MSFT', 'NVDA', 'AMD'];
const coverage = [...reports].sort((a, b) => {
  const priority = (ticker: string) => {
    const featured = priorityTickers.indexOf(ticker);
    if (featured !== -1) return featured;
    const tracked = watchlist.indexOf(ticker);
    return priorityTickers.length + (tracked === -1 ? watchlist.length : tracked);
  };
  return priority(a.data.ticker) - priority(b.data.ticker) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
});
const trackedCoverage = coverage.filter((report) => trackedAssetByTicker.has(report.data.ticker));
const coverageMarkets = [...new Set(trackedAssets.map(({ market }) => market))];
const marketLabel = (market: string) => market === 'TW' ? '台股' : market === 'UK' ? '英國／倫敦掛牌' : '美股';
const assetTypeLabel = (assetType: string) => assetType === 'etf' ? 'ETF' : assetType === 'bdc' ? 'BDC／收益型' : '個股';
const tagCloud = groupReportsByTag(allReports).slice(0, 18);
const siteUrl = 'https://coldnew.github.io/stock/';
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>每日投資研究｜Stock Reports</title><meta name="description" content="繁體中文股票、ETF 與市場事件研究：追蹤行情、基本面、技術面、估值、風險與可驗證的投資條件。" /><meta name="author" content="Yen-Chin, Lee" /><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" /><link rel="alternate" type="application/rss+xml" title="每日投資研究 RSS" href="/stock/rss.xml" />
    <link rel="canonical" href={`https://coldnew.github.io/stock${currentPage === 1 ? '/' : `/page/${currentPage}/`}`} /><meta property="og:type" content="website" /><meta property="og:title" content="每日投資研究｜Stock Reports" /><meta property="og:description" content="繁體中文股票、ETF 與市場事件研究。" /><meta property="og:url" content={`${siteUrl}${currentPage === 1 ? '' : `page/${currentPage}/`}`} /><meta property="og:image" content="https://coldnew.github.io/stock/og-default.svg" /><meta property="og:image:alt" content="Stock Reports 繁體中文投資研究" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content="https://coldnew.github.io/stock/og-default.svg" /><Analytics />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'WebSite', name: 'Stock Reports', url: siteUrl,
      description: '繁體中文股票、ETF 與市場事件研究。', inLanguage: 'zh-TW', publisher: { '@type': 'Organization', name: 'Stock Reports', url: siteUrl },
    })} />
  </head>
  <body>
    <header class="index-header">
      <nav class="site-nav"><a class="site-mark" href="/stock/">RESEARCH DESK</a><span>每日投資筆記</span><SearchDialog /></nav>
      <p class="eyebrow">每日投資研究</p><h1>用更冷靜的方式閱讀市場。</h1>
      <p class="index-intro">每天只回答三件事：發生了什麼、什麼真正重要，以及什麼情況會讓投資論點改變。</p>
      <p class="index-note">本站報告以台灣投資人為主要對象。收益型基金的配息可能包含 ROC（資本返還）；稅務與投資決策請以第一手資料及專業意見為準。</p>
      <AiDisclosure locale="zh-TW" />
    </header>
    <AdSlot placement="top" />
    <main>
      <section class="coverage" aria-labelledby="coverage-title"><div class="section-heading"><p class="eyebrow">明確列入追蹤的標的</p><h2 id="coverage-title">目前追蹤</h2><p class="coverage-note">可先按市場，再按資產類型篩選。未來加入台股 ETF 或其他收益型工具時，不需要重新設計首頁。</p></div><div class="coverage-tabs" data-tab-group="coverage-market" role="tablist" aria-label="追蹤市場分類"><button type="button" role="tab" aria-selected="true" aria-controls="coverage-market-all" id="coverage-market-tab-all" data-market-filter="all">全部 <span>{trackedCoverage.length}</span></button>{coverageMarkets.map((market) => <button type="button" role="tab" aria-selected="false" aria-controls={`coverage-market-${market}`} id={`coverage-market-tab-${market}`} data-market-filter={market}>{marketLabel(market)} <span>{trackedCoverage.filter((report) => trackedAssetByTicker.get(report.data.ticker)?.market === market).length}</span></button>)}</div><div class="coverage-tabs" data-tab-group="coverage-type" role="tablist" aria-label="資產類型分類"><button type="button" role="tab" aria-selected="true" data-type-filter="all">全部類型</button>{['equity', 'etf', 'bdc'].map((assetType) => <button type="button" role="tab" aria-selected="false" data-type-filter={assetType}>{assetTypeLabel(assetType)} <span>{trackedCoverage.filter((report) => trackedAssetByTicker.get(report.data.ticker)?.assetType === assetType).length}</span></button>)}</div><div class="coverage-panel" role="tabpanel" id="coverage-market-all" data-coverage-panel><div class="coverage-grid">{trackedCoverage.map((report) => { const asset = trackedAssetByTicker.get(report.data.ticker)!; return <a class="coverage-item" href={reportUrl(report)} data-market={asset.market} data-asset-type={asset.assetType}><span class="ticker">{asset.displayTicker}</span><span>{report.data.title}</span><span aria-hidden="true">↗</span></a>; })}</div></div></section>
      <section class="tag-cloud-section" aria-labelledby="tag-cloud-title"><div class="section-heading"><p class="eyebrow">文章索引</p><h2 id="tag-cloud-title">依標籤瀏覽</h2></div><div class="tag-cloud">{tagCloud.map((tag) => <a class="tag-link" href={tagHref(tag.label)}>#{tag.label}<span>{tag.reports.length}</span></a>)}</div></section>
      <section class="daily-feed" aria-labelledby="feed-title"><div class="section-heading"><p class="eyebrow">編輯室文章</p><h2 id="feed-title">每日報導</h2></div><div class="post-list">{feed.map((report) => <article class="post-row"><div class="post-row-meta"><strong>{report.data.ticker}</strong><time datetime={dateLabel(report.data.publishedAt)}>{dateLabel(report.data.publishedAt)}</time><span>{deskLabel(report)}</span></div><div><h3><a href={reportUrl(report)}>{report.data.title}</a></h3><p>{report.data.description}</p><a class="read-link" href={reportUrl(report)}>繼續閱讀 →</a></div></article>)}</div><nav class="pagination" aria-label="每日報導分頁">{currentPage > 1 && <a class="pagination-prev" href={currentPage === 2 ? '/stock/' : `/stock/page/${currentPage - 1}/`} rel="prev">‹ 上一頁</a>}<div class="pagination-pages">{Array.from({ length: totalPages }, (_, index) => index + 1).map((number) => number === currentPage ? <span aria-current="page">{number}</span> : <a href={number === 1 ? '/stock/' : `/stock/page/${number}/`}>{number}</a>)}</div>{currentPage < totalPages && <a class="pagination-next" href={`/stock/page/${currentPage + 1}/`} rel="next">下一頁 ›</a>}</nav></section>
      <AdSlot placement="mid" />
    </main>
    <AdSlot placement="bottom" /><AdSlot placement="smartlink" />
    <footer class="index-footer"><span>僅供教育與資訊參考，不構成投資建議。</span><span class="footer-links"><a href="/stock/about.html">關於本站</a><a href="/stock/privacy.html">隱私權政策</a><a href="/stock/disclaimer.html">免責聲明</a></span></footer>
    <script is:inline src="/stock/report-interactions.js"></script>
    <script is:inline>
      (function () {
        var marketGroup = document.querySelector('[data-tab-group="coverage-market"]');
        var typeGroup = document.querySelector('[data-tab-group="coverage-type"]');
        var items = Array.prototype.slice.call(document.querySelectorAll('[data-coverage-panel] .coverage-item'));
        if (!marketGroup || !typeGroup) return;
        var market = 'all';
        var assetType = 'all';
        function activate(group, tab, attribute) {
          Array.prototype.slice.call(group.querySelectorAll('[role="tab"]')).forEach(function (item) {
            item.setAttribute('aria-selected', String(item === tab));
          });
          if (attribute === 'data-market-filter') market = tab.getAttribute(attribute);
          else assetType = tab.getAttribute(attribute);
          items.forEach(function (item) {
            var visible = (market === 'all' || item.getAttribute('data-market') === market) && (assetType === 'all' || item.getAttribute('data-asset-type') === assetType);
            item.hidden = !visible;
            item.style.display = visible ? '' : 'none';
          });
        }
        [[marketGroup, 'data-market-filter'], [typeGroup, 'data-type-filter']].forEach(function (pair) {
          var group = pair[0];
          var attribute = pair[1];
          group.querySelectorAll('[role="tab"]').forEach(function (tab) { tab.addEventListener('click', function () { activate(group, tab, attribute); }); });
        });
      })();
    </script>
    <MonetizationScripts />
  </body>
</html>

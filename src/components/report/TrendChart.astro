---
interface Props {
  labels: string[];
  values: number[];
  title?: string;
  unit?: string;
}

const { labels, values, title = 'Trend', unit = '' } = Astro.props as Props;
const width = 900;
const height = 300;
const pad = { top: 24, right: 24, bottom: 42, left: 58 };
const min = Math.min(...values);
const max = Math.max(...values);
const span = max - min || 1;
const x = (index: number) => pad.left + index * ((width - pad.left - pad.right) / Math.max(values.length - 1, 1));
const y = (value: number) => pad.top + (max - value) * ((height - pad.top - pad.bottom) / span);
const points = values.map((value, index) => `${x(index)},${y(value)}`).join(' ');
const grid = [0, 0.5, 1].map((ratio) => ({ y: pad.top + ratio * (height - pad.top - pad.bottom), value: max - ratio * span }));
---
<figure class="trend-chart" aria-label={title}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title}>
    <rect width="100%" height="100%" fill="var(--ivory)" />
    {grid.map((line) => <g><line x1={pad.left} y1={line.y} x2={width - pad.right} y2={line.y} stroke="var(--border)" stroke-width="1" /><text x={pad.left - 8} y={line.y + 4} text-anchor="end" fill="var(--stone)" font-size="12">{unit}{line.value.toFixed(0)}</text></g>)}
    <polyline points={points} fill="none" stroke="var(--brand)" stroke-width="3" />
    {values.map((value, index) => <circle cx={x(index)} cy={y(value)} r="4" fill="var(--brand)" />)}
    {labels.map((label, index) => <text x={x(index)} y={height - 14} text-anchor="middle" fill="var(--stone)" font-size="11">{label}</text>)}
  </svg>
  <figcaption>{title} · {labels[0]}–{labels.at(-1)}</figcaption>
</figure>

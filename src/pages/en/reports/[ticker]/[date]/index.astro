---
import { getCollection } from 'astro:content';
import ReportLayout from '../../../../../components/report/ReportLayout.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports', ({ data }) => data.locale === 'en' && data.status === 'published');
  return reports.map((entry) => ({
    params: { ticker: entry.data.ticker.toLowerCase(), date: entry.data.publishedAt.toISOString().slice(0, 10) },
    props: { entry },
  }));
}
const { entry } = Astro.props;
---
<ReportLayout entry={entry} archive />

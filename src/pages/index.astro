---
import { getLatestReports, getReports } from '../data/reports';
import ReportIndex from '../components/report/ReportIndex.astro';
const reports = await getLatestReports('zh-TW');
const allReports = (await getReports('zh-TW')).filter((report) => report.data.status === 'published');
---
<ReportIndex reports={reports} allReports={allReports} locale="zh-TW" />

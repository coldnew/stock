---
import { getReports, getLatestReports } from '../../../data/reports';
import ReportIndex from '../../../components/report/ReportIndex.astro';

const pageSize = 10;

export async function getStaticPaths() {
  const pageSize = 10;
  const published = (await getReports('zh-TW')).filter((report) => report.data.status === 'published');
  const totalPages = Math.max(1, Math.ceil(published.length / pageSize));

  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: index + 2 },
  }));
}

const { page } = Astro.props as { page: number };
const published = (await getReports('zh-TW')).filter((report) => report.data.status === 'published');
const reports = await getLatestReports('zh-TW');
---

<ReportIndex reports={reports} allReports={published} page={page} pageSize={pageSize} locale="zh-TW" />

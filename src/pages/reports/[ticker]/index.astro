---
import { getCollection } from 'astro:content';
import ReportLayout from '../../../components/report/ReportLayout.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports', ({ data }) => data.locale === 'zh-TW' && data.isLatest && data.status === 'published');
  return reports.map((entry) => ({ params: { ticker: entry.data.ticker.toLowerCase() }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ReportLayout entry={entry} />
